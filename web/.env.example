# WalletConnect Cloud project id (https://cloud.reown.com). Without it only browser-injected wallets work.
VITE_WALLETCONNECT_PROJECT_ID=
# Show the local Hardhat network and the one-click local dev wallet (on by default in `npm run dev`).
VITE_ENABLE_LOCAL=true
# Optional RPC overrides
VITE_MAINNET_RPC_URL=
VITE_BASE_RPC_URL=
VITE_SEPOLIA_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
